{
  "name": "@audiorective/daw",
  "version": "2.3.2",
  "description": "Audio and MIDI projects, the DAWproject codec and a browser playback runtime",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/audiorective/audiorective/tree/main/packages/daw#readme",
  "bugs": {
    "url": "https://github.com/audiorective/audiorective/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiorective/audiorective.git",
    "directory": "packages/daw"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "import": "./dist/selection.js"
    },
    "./dawproject": {
      "types": "./dist/dawproject.d.ts",
      "import": "./dist/dawproject.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "probe:cubase": "node probes/cubase-export.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@audiorective/core": "workspace:^",
    "@audiorective/clock": "workspace:^",
    "@audiorective/effects": "workspace:^",
    "@audiorective/host": "workspace:^",
    "@audiorective/midi": "workspace:^",
    "@xmldom/xmldom": "^0.9.8",
    "fflate": "^0.8.2",
    "@audiorective/launcher": "workspace:^",
    "@audiorective/player": "workspace:^",
    "@audiorective/recorder": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "playwright": "^1.58.2",
    "tsdown": "^0.15.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@audiorective/sequencer": "workspace:^"
  },
  "sideEffects": false
}
