{
  "name": "@audiorective/mcp",
  "version": "3.0.0-beta.0",
  "description": "MCP stdio server that relays an agent's tool calls to an audiorective page over a WebSocket",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/audiorective/audiorective/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/audiorective/audiorective/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiorective/audiorective.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "audiorective-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/ws": "8.18.1",
    "tsdown": "^0.15.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
