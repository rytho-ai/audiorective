{
  "name": "@audiorective/blocks",
  "version": "2.3.2",
  "description": "Headless audio capture, range playback and cancellable instrument events",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/audiorective/audiorective/tree/main/packages/blocks#readme",
  "bugs": {
    "url": "https://github.com/audiorective/audiorective/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiorective/audiorective.git",
    "directory": "packages/blocks"
  },
  "author": "Chriest Yu <jcppman@gmai.com>",
  "files": [
    "dist"
  ],
  "exports": {
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js"
    },
    "./recorder": {
      "types": "./dist/recorder.d.ts",
      "import": "./dist/recorder.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "import": "./dist/samples.js"
    },
    "./instrument-events": {
      "types": "./dist/instrument-events.d.ts",
      "import": "./dist/instrument-events.js"
    },
    "./sequencer": {
      "types": "./dist/sequencer.d.ts",
      "import": "./dist/sequencer.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@audiorective/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "playwright": "^1.58.2",
    "tsdown": "^0.15.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "sideEffects": false
}
